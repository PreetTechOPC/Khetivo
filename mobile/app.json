{
  "expo": {
    "name": "Khetivo - Smart Agriculture",
    "slug": "khetivo-mobile",
    "scheme": ["khetivo", "appwrite-callback-6ae72036002d13f9c902"],
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C4B32"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.khetivo.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C4B32"
      },
      "package": "com.khetivo.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-status-bar"
    ]
  }
}
